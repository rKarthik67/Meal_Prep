# Postgres.app on macOS: your mac username, no password, localhost
DATABASE_URL=postgresql+psycopg://localhost:5432/meal_prep
# dev = no Firebase needed (token "dev:<phone>"), firebase = verify Firebase ID tokens
AUTH_MODE=dev
# FIREBASE_CREDENTIALS=/Users/karthikeyanr/Meal_Prep/backend/firebase-service-account.json

# ---------------- AI ----------------
# Default provider for the AI agents: mock | azure | anthropic | ollama
# (mock works offline with no keys; every provider you configure below can also be picked in the app)
AI_PROVIDER=mock

# Azure OpenAI / Foundry
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Anthropic (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama (local): `ollama pull llama3.1:8b` first
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
